        file="{waypoint_file}" 
        waypoints="{waypoint_list}"/>
      
      <!-- Use Nav2's FollowWaypoints behavior -->
      <FollowWaypoints waypoints="{waypoint_list}"/>
      
    </Sequence>
  </BehaviorTree>
</root>